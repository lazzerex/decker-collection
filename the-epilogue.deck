{card:FinalMemory}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,80],"pos":[8,22],"locked":1,"align":"center","value":"\nYou gather the final shard.\nMemories flood in. Joy, pain, hope and regret.\nYou see your life, the truth of your death, the weight of your existence.\nYou remember everything and nothing.\nIs memory a prison, or the last gift?"}
next:{"type":"button","size":[120,30],"pos":[138,192],"script":"FinalMemory.0","text":"Let it All Go","style":"rect"}


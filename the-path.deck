{card:Intro}
image:"%%"
{widgets}
title:{"type":"field","size":[300,30],"pos":[50,36],"locked":1,"script":"Intro.0","font":"menu","pattern":28,"align":"center","value":"You emerge from the white room. The world breathes, but not as you remember."}
walk:{"type":"button","size":[125,30],"pos":[21,149],"script":"Intro.1","text":"Step into the Mirage","style":"rect"}
back:{"type":"button","size":[120,30],"pos":[252,256],"script":"Intro.2","text":"Gaze Backward","style":"rect"}

{script:Intro.0}
on change val do
 
end
{end}

{script:Intro.1}
on click do
  go["Street" "SlideLeft"]
end
{end}

{script:Intro.2}
on click do
  go["ReturnEnd" "BoxOut"]
end
{end}

{card:Street}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,30],"pos":[10,20],"locked":1,"align":"center","value":"The street coils into infinity. Passersby have clocks for faces, ticking in reverse."}
talk:{"type":"button","size":[147,30],"pos":[14,245],"script":"Street.0","text":"Speak to the Clockface","style":"rect"}
walk:{"type":"button","size":[120,30],"pos":[257,117],"script":"Street.1","text":"Wander the Spiral","style":"rect"}

{script:Street.0}
on click do
  go["Stranger" "SlideUp"]
end
{end}

{script:Street.1}
on click do
  go["Distortion" "SlideDown"]
end
{end}

{card:Stranger}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,30],"pos":[10,20],"locked":1,"align":"center","value":"The stranger hums a melody of forgotten names. Their mouth moves, but only echoes spill out."}
listen:{"type":"button","size":[120,30],"pos":[40,100],"script":"Stranger.0","text":"Lean into the Echo","style":"rect"}
away:{"type":"button","size":[120,30],"pos":[240,100],"script":"Stranger.1","text":"Step from the Song","style":"rect"}

{script:Stranger.0}
on click do
  go["Distortion" "BoxIn"]
end
{end}

{script:Stranger.1}
on click do
  go["Distortion" "WipeDown"]
end
{end}

{card:Distortion}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,30],"pos":[10,20],"locked":1,"align":"center","value":"Reality ripples like water. Buildings melt into sky. Your thoughts taste of static."}
call:{"type":"button","size":[120,30],"pos":[22,91],"script":"Distortion.0","text":"Whisper to the Void","style":"rect"}
embrace:{"type":"button","size":[120,30],"pos":[274,120],"script":"Distortion.1","text":"Dissolve into Color","style":"rect"}
shard:{"type":"button","size":[111,25],"pos":[286,252],"script":"Distortion.2","text":"Pick up the Shard","style":"invisible"}

{script:Distortion.0}
on click do
  go["ThoughtMaze" "SlideLeft"]
end
{end}

{script:Distortion.1}
on click do
  go["ThoughtMaze" "SlideUp"]
end
{end}

{script:Distortion.2}
on click do
  go["ShardCarry" "BoxIn"]
end
{end}

{card:card1}

{card:ShardCarry}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,40],"pos":[10,20],"locked":1,"align":"center","value":"You hold the shard of memory. It pulses with forgotten light. Visions flicker at the edge of your mind."}
vision:{"type":"button","size":[180,30],"pos":[110,100],"script":"ShardCarry.0","text":"Gaze into the Shard","style":"rect"}

{script:ShardCarry.0}
on click do
  go["ShardVision" "SlideUp"]
end
{end}

{card:ShardVision}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,37],"pos":[10,20],"locked":1,"align":"center","value":"A memory floods your senses: laughter in a sunlit room, a name on the tip of your tongue. The vision fractures, colors bleeding into one another."}
next:{"type":"button","size":[120,30],"pos":[135,119],"script":"ShardVision.0","text":"Let it Flow"}

{script:ShardVision.0}
on click do
  go["FragmentEcho" "BoxOut"]
end
{end}

{card:FragmentEcho}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,60],"pos":[10,20],"locked":1,"align":"center","value":"You hear a voice, not your own: 'Each shard is a question you once asked. Each answer, a piece of yourself.'\n\nThe Observer stands before you, waiting."}
give:{"type":"button","size":[189,30],"pos":[104,95],"script":"FragmentEcho.0","text":"Give the Shard to the Observer","style":"rect"}

{script:FragmentEcho.0}
on click do
  go["TrueEnd" "BoxOut"]
end
{end}

{card:ThoughtMaze}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,30],"pos":[10,20],"locked":1,"align":"center","value":"Thoughts spiral: 'Is the cage the mind, or the world? Who dreams whom?'"}
question:{"type":"button","size":[120,30],"pos":[25,164],"script":"ThoughtMaze.0","text":"Doubt the Dream","style":"rect"}
accept:{"type":"button","size":[120,30],"pos":[263,164],"script":"ThoughtMaze.1","text":"Follow the Mirage","style":"rect"}

{script:ThoughtMaze.0}
on click do
  go["Observer" "SlideRight"]
end
{end}

{script:ThoughtMaze.1}
on click do
  go["ContinueEnd" "SlideLeft"]
end
{end}

{card:Observer}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,30],"pos":[10,20],"locked":1,"align":"center","value":"The Observer hovers, eyes like endless mirrors. 'You have left the only true freedom. Here, you are seen.'"}
argue:{"type":"button","size":[89,25],"pos":[40,101],"script":"Observer.0","text":"Defy the Gaze","style":"rect"}
ask:{"type":"button","size":[95,25],"pos":[160,100],"script":"Observer.0","text":"Ask the Mirror","style":"rect"}
silent:{"type":"button","size":[90,25],"pos":[280,100],"script":"Observer.0","text":"Vanish Within","style":"rect"}

{script:Observer.0}
on click do
  go["Philosophy" "BoxIn"]
end
{end}

{card:Philosophy}
image:"%%"
{widgets}
prompt:{"type":"field","size":[380,30],"pos":[10,20],"locked":1,"align":"center","value":"Observer: 'Is existence a labyrinth, or a locked door? Are you the key, or the hand that turns it?'"}
path:{"type":"button","size":[100,25],"pos":[30,100],"script":"Philosophy.0","text":"I am the Path","style":"rect"}
prison:{"type":"button","size":[100,25],"pos":[157,100],"script":"Intro.2","text":"I am the Prison","style":"rect"}
dk:{"type":"button","size":[107,25],"pos":[279,100],"script":"Philosophy.1","text":"I am the Question","style":"rect"}

{script:Philosophy.0}
on click do
  go["ContinueEnd" "BoxOut"]
end
{end}

{script:Philosophy.1}
on click do
  go["ConfrontEnd" "BoxOut"]
end
{end}

{card:ReturnEnd}
image:"%%"
{widgets}
message:{"type":"field","size":[380,30],"pos":[10,20],"locked":1,"align":"center","value":"You dissolve into the white room. Silence is your only companion, and your only jailer."}
restart:{"type":"button","size":[80,25],"pos":[160,100],"script":"ReturnEnd.0","text":"Restart","style":"rect"}

{script:ReturnEnd.0}
on click do
  go["Intro" "BoxOut"]
end
{end}

{card:ContinueEnd}
image:"%%"
{widgets}
message:{"type":"field","size":[380,30],"pos":[10,20],"locked":1,"align":"center","value":"You walk into the endless corridor of questions. Each step is a door, each breath a riddle."}
restart:{"type":"button","size":[80,25],"pos":[164,109],"script":"ReturnEnd.0","text":"Restart","style":"rect"}

{card:ConfrontEnd}
image:"%%"
{widgets}
message:{"type":"field","size":[380,30],"pos":[10,20],"locked":1,"align":"center","value":"The world fractures. In the shards, you glimpse a thousand versions of yourself, all asking: Who is the dreamer?"}
restart:{"type":"button","size":[80,25],"pos":[160,100],"script":"ReturnEnd.0","text":"Restart","style":"rect"}

{card:TrueEnd}
image:"%%"
{widgets}
message:{"type":"field","size":[380,65],"pos":[10,20],"locked":1,"align":"center","value":"You hand the Observer the shard of memory. The world halts.\n\nObserver: 'You have not escaped. This is Limbo. Your memories are scattered, waiting to be found.'\n\nA new journey begins."}
restart:{"type":"button","size":[80,25],"pos":[165,112],"script":"ReturnEnd.0","text":"Restart","style":"rect"}

